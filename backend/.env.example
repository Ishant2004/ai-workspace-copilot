# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# The Gemini model used for chat completion.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of origins allowed to call the API (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# Embeddings (Phase 2). GEMINI_EMBED_DIM becomes the pgvector column size in
# Phase 3, so keep it fixed once you start storing documents.
GEMINI_EMBED_MODEL=gemini-embedding-001
GEMINI_EMBED_DIM=768

# Vector DB (Phase 3). Free Neon Postgres connection string.
# Get one at https://neon.tech — create a project and copy the connection URL.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
